# Copy to `.env` next to docker-compose.prod.yml and fill in secrets.
# NEVER commit real secrets. Prefer platform secret injection; the config layer
# also accepts `<KEY>_FILE` paths for Docker/k8s secret mounts.

# --- Required secrets (compose fails fast when missing) -----------------------
REDIS_PASSWORD=
# Must equal simple_agent's SIMPLE_AGENT_SERVICE_AUTH_SIGNING_KEY (single
# contract, operations.md §3.1). Required for the memory service.
SERVICE_AUTH_SIGNING_KEY=

# --- Optional image/tag overrides --------------------------------------------
RAG_IMAGE_TAG=latest
# REDPANDA_TAG=latest
# QDRANT_TAG=v1.9.7

# --- Embeddings (override for smoke runs) -------------------------------------
# RAG_EMBEDDING_PROVIDER=deterministic
# RAG_EMBEDDING_MODEL=deterministic-hash
# RAG_EMBEDDING_DIMENSION=384

# --- Manager public-edge guards -----------------------------------------------
# MANAGER_RATE_LIMIT_REQUESTS_PER_SECOND=100
# MANAGER_RATE_LIMIT_BURST=200
# MANAGER_MAX_REQUEST_BYTES=4194304

# --- Broker SASL/TLS (hardening; see docker-compose.prod.yml x-rag-env) -------
# BROKER_SASL_PLAIN_USERNAME=
# BROKER_SASL_PLAIN_PASSWORD=

# --- Logging -------------------------------------------------------------------
# RAG_LOG_FORMAT=json
# RAG_LOG_LEVEL=INFO
