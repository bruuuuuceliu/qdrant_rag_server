# Copy to `.env` next to docker-compose.prod.yml and fill in secrets.
# NEVER commit real secrets. Prefer platform secret injection; the config layer
# also accepts `<KEY>_FILE` paths for Docker/k8s secret mounts.

# --- Required secrets (compose fails fast when missing) -----------------------
REDIS_PASSWORD=
# RAG-owned Postgres — the always-on durable-store backend. Required by the
# compose. Never on rag-memory-test.
POSTGRES_PASSWORD=
# Optional overrides for the RAG-owned Postgres (defaults: rag / rag / rag).
# POSTGRES_USER=rag
# POSTGRES_DB=rag
# Single shared signing key (operations.md §3.1): MUST equal simple_agent's
# SIMPLE_AGENT_SERVICE_AUTH_SIGNING_KEY. Required for the memory service. Never
# commit; inject via a secret manager or <KEY>_FILE.
SERVICE_AUTH_SIGNING_KEY=

# --- Broker / shared memory-path network --------------------------------------
# Empty topic prefix = BARE topics shared with simple_agent (domain.memory.*,
# identity.user.events). Do not set a qdrant-rag-local. prefix here.
BROKER_TOPIC_PREFIX=
# Token svc allow-list for memory_service (must include conversation-server).
MEMORY_ALLOWED_SERVICES=conversation-server
# Auth contract, must match simple_agent's x-service-auth
# (SA compose.production.yaml line 64): simple-agent-local /
# simple-agent-internal / 300. Mismatch => every memory token 401/403.
SERVICE_AUTH_TOKEN_ISSUER=simple-agent-local
SERVICE_AUTH_TOKEN_AUDIENCE=simple-agent-internal
SERVICE_AUTH_TOKEN_TTL_SECONDS=300
# The internal listener redpanda-rag-local:19092 is NOT host-published by the
# base compose (private network only). For host-local interop access add
# -f docker-compose.prod.override.interop.yml (publishes 127.0.0.1:19092).

# --- Optional image/tag overrides --------------------------------------------
RAG_IMAGE_TAG=latest
# REDPANDA_TAG=latest
# QDRANT_TAG=v1.9.7

# --- Embeddings (override for smoke runs) -------------------------------------
# RAG_EMBEDDING_PROVIDER=deterministic
# RAG_EMBEDDING_MODEL=deterministic-hash
# RAG_EMBEDDING_DIMENSION=384

# --- Manager public-edge guards -----------------------------------------------
# MANAGER_RATE_LIMIT_REQUESTS_PER_SECOND=100
# MANAGER_RATE_LIMIT_BURST=200
# MANAGER_MAX_REQUEST_BYTES=4194304

# --- Broker SASL/TLS (hardening; see docker-compose.prod.yml x-rag-env) -------
# BROKER_SASL_PLAIN_USERNAME=
# BROKER_SASL_PLAIN_PASSWORD=

# --- Postgres-always durable-store backend -----------------------------------
# All non-vector stores resolve their DSN from RAG_POSTGRES_URL (set in
# docker-compose.prod.yml x-rag-env). A per-store *_DB_URL override, if ever
# needed, wins for that store only.
# MEMORY_DB_URL=
# TASK_SERVICE_STATE_DB_URL=
# PROJECT_CONFIG_DB_URL=
# WORKFLOW_LOG_DB_URL=
# INGESTION_JOB_DB_URL=
# RETRIEVAL_PLACEMENT_DB_URL=
# RAG_RESPONSE_CACHE_DB_URL=

# --- Logging -------------------------------------------------------------------
# RAG_LOG_FORMAT=json
# RAG_LOG_LEVEL=INFO
