# Local Redpanda broker settings
BROKER_TYPE=redpanda
BROKER_BOOTSTRAP_SERVERS=127.0.0.1:9092
BROKER_CLIENT_ID=qdrant-rag-local
BROKER_REQUEST_TIMEOUT_SECONDS=30
BROKER_TOPIC_PREFIX=
BROKER_TOPIC_PARTITIONS=1

# Optional readiness lag probes. Format:
#   group_id:topic,topic;group_id:topic
# Example broker-first local groups:
# BROKER_LAG_TARGETS=task_manager_service:task.intake;task_manager_service.domain.0:domain.project.results;task_manager_service.domain.1:domain.workflow_log.results;task_manager_service.helper.0:helper.ingestion.results;task_manager_service.helper.1:helper.retrieval.results;task_manager_service.helper.2:helper.retrieval_index.results;task_manager_service.helper.3:helper.storage.results;project_service:domain.project.commands;workflow_log_service:domain.workflow_log.commands;ingestion_service:helper.ingestion.commands;retrieval_service:helper.retrieval.commands;retrieval_index_service:helper.retrieval_index.commands;storage_node:helper.storage.commands
