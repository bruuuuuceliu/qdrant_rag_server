# Local Kafka-protocol broker settings.
# Supported local Docker brokers are redpanda and kafka.
BROKER_TYPE=redpanda
BROKER_BOOTSTRAP_SERVERS=127.0.0.1:9092
BROKER_CLIENT_ID=qdrant-rag-local
BROKER_REQUEST_TIMEOUT_SECONDS=30
BROKER_TOPIC_PREFIX=
BROKER_TOPIC_PARTITIONS=1

# Optional readiness lag probes. Format:
#   group_id:topic,topic;group_id:topic
# Example broker-first local groups:
# BROKER_LAG_TARGETS=task_manager_service:task.intake,task.events,task.results;task_service:task.requests;task_service.project_plan.0:project.plan.results;task_service.helper.0:helper.ingestion.results;task_service.helper.1:helper.retrieval.results;task_service.helper.2:helper.retrieval_index.results;task_service.helper.3:helper.storage.results;project_service:project.plan.requests;workflow_log_service:domain.workflow_log.commands;ingestion_service:helper.ingestion.commands;retrieval_service:helper.retrieval.commands;retrieval_index_service:helper.retrieval_index.commands;storage_node:helper.storage.commands
