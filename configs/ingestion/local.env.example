INGESTION_SERVICE_NAME=ingestion_service
INGESTION_REQUEST_TOPIC=ingestion.requests
INGESTION_HELPER_COMMAND_TOPIC=helper.ingestion.commands
INGESTION_WORKER_COUNT=1
INGESTION_QUEUE_MAXSIZE=100
INGESTION_JOB_DB_PATH=.run/data/ingestion_jobs.db

# Required publication of prepared chunks to retrieval indexing.
INGESTION_RETRIEVAL_INDEX_ENABLED=true
INGESTION_RETRIEVAL_INDEX_TOPIC=retrieval.index.requests
INGESTION_RETRIEVAL_INDEX_QUEUE_BROKER=sqlite
INGESTION_RETRIEVAL_INDEX_QUEUE_DB_PATH=.run/data/ingestion_queue.db
INGESTION_RETRIEVAL_INDEX_QUEUE_MAXSIZE=100
INGESTION_RETRIEVAL_INDEX_RESPONSE_TIMEOUT=30
