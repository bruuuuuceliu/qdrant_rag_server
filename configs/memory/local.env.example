# Local memory domain-service settings (fake modes for standalone dev/tests)
MEMORY_SERVICE_ENABLED=true
MEMORY_SERVICE_NAME=memory_service
MEMORY_DOMAIN_COMMAND_TOPIC=domain.memory.commands
MEMORY_DOMAIN_RESULT_TOPIC=domain.memory.results
MEMORY_IDENTITY_TOPIC=identity.user.events
MEMORY_DB_PATH=.run/data/agent_memory.db

# identity: broker consumes identity.user.events; fake seeds fixed local users
MEMORY_IDENTITY_MODE=fake
# index: broker hands records to retrieval_service; fake indexes in-process
MEMORY_INDEX_MODE=fake
# search: broker requests semantic lookup from retrieval_service; fake is local
MEMORY_SEARCH_MODE=fake

# Caller services allowed to issue memory commands (service-token claim check)
MEMORY_ALLOWED_SERVICES=conversation-server

# Service-auth signing settings (must match simple_agent local/dev values)
SERVICE_AUTH_SIGNING_KEY=local-dev-signing-key
SERVICE_AUTH_TOKEN_ISSUER=simple-agent-local
SERVICE_AUTH_TOKEN_AUDIENCE=simple-agent-internal
SERVICE_AUTH_TOKEN_TTL_SECONDS=300

# Vector collections used for the memory/documents sources
MEMORY_COLLECTION=agent_memory
MEMORY_DOCUMENTS_COLLECTION=agent_memory
MEMORY_LOOKUP_INCLUDE_MERGED=false
