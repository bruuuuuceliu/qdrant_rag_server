# Sparse retrieval and NER component settings.
#
# These settings only make services available at runtime. Per-project behavior
# still comes from project retrieval_config:
#   mode=dense | bm25 | hybrid

BM25_SPARSE_VECTOR_NAME=bm25
BM25_DENSE_VECTOR_NAME=dense
BM25_ENCODER_PROVIDER=fastembed
BM25_ENCODER_MODEL=Qdrant/bm25
BM25_TEXT_FIELD=text_lemmatized
BM25_LEMMATIZE=true
BM25_INDEX_VERSION=qdrant_bm25_v1

RAG_NER_PROVIDER=disabled
RAG_NER_MODEL=en_core_web_sm

# Retrieval broker helper transport.
RETRIEVAL_HELPER_SERVICE_NAME=retrieval_service
RETRIEVAL_HELPER_COMMAND_TOPIC=helper.retrieval.commands

# Standalone retrieval indexing worker.
RETRIEVAL_INDEX_WORKER_ENABLED=true
RETRIEVAL_INDEX_HELPER_COMMAND_TOPIC=helper.retrieval_index.commands

# Retrieval/database placement registry and local default shard.
RETRIEVAL_PLACEMENT_ENABLED=true
RETRIEVAL_PLACEMENT_DB_PATH=.run/data/placement.db
RETRIEVAL_PLACEMENT_ROUTING_MODE=project_single
RETRIEVAL_PLACEMENT_BUCKET_COUNT=1
RETRIEVAL_PLACEMENT_REPLICATION_FACTOR=1
RETRIEVAL_PLACEMENT_SHARD_ID=local-qdrant
RETRIEVAL_PLACEMENT_CLUSTER_ID=local
