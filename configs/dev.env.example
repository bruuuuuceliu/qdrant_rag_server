RAG_CONFIG_PROFILE=dev

# Dev data/runtime workspace, quarantined inside the shared SA project workspace
# (never under /data/).
RAG_LOCAL_DATA_DIR=~/projects/simple_agent/rag-dev/data
RAG_LOCAL_RUNTIME_DIR=~/projects/simple_agent/rag-dev

# Postgres-always backend: every non-vector store resolves its DSN from
# RAG_POSTGRES_URL (override per store with its *_DB_URL).
RAG_POSTGRES_URL=postgresql://rag:rag@localhost:5432/rag

RAG_GRPC_PORT=50051
RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
RAG_LOG_FORMAT=text
RAG_LOG_LEVEL=DEBUG

# Memory modes: broker talks to Redpanda; fake is self-contained.
MEMORY_IDENTITY_MODE=fake
MEMORY_INDEX_MODE=fake
MEMORY_SEARCH_MODE=fake
