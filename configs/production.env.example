RAG_RESPONSE_CACHE_DB_PATH=/var/lib/retrieval_service/response_cache.db
RAG_GRPC_PORT=50051

RAG_GENERATION_ENABLED=false

# ---- Ops surface + structured logging ----------------------------------------
# /healthz + /readyz + /metrics per service. Each service defaults to its own
# RAG_OPS_PORT in the production compose (9001-9012); RAG_OPS_ENABLED is set by
# the compose and defaults off locally.
RAG_OPS_ENABLED=true
RAG_OPS_HOST=0.0.0.0
RAG_OPS_PORT=9001
RAG_LOG_FORMAT=json
RAG_LOG_LEVEL=INFO
# Optional OpenTelemetry OTLP/gRPC endpoint (requires the [tracing] extras).
# RAG_OTEL_ENDPOINT=http://otel-collector:4317

# ---- Manager public-edge guards (rate limiting + payload cap) ----------------
# Token-bucket rate limit on the public gRPC API and a per-message size cap
# enforced at the gRPC transport. Tune to the expected client burst.
# MANAGER_RATE_LIMIT_REQUESTS_PER_SECOND=100
# MANAGER_RATE_LIMIT_BURST=200
# MANAGER_MAX_REQUEST_BYTES=4194304

# ---- Broker transport security (C5, SASL/TLS) -------------------------------
# Production connects to the internal redpanda-rag-local listener with
# SASL/SCRAM + TLS. Every memory-path client (RAG workers AND simple_agent's
# conversation-server/identity-server) must present the same credentials.
# BROKER_BOOTSTRAP_SERVERS=redpanda-rag-local:19092
BROKER_SECURITY_PROTOCOL=SASL_SSL
BROKER_SASL_MECHANISM=SCRAM-SHA-256
BROKER_SASL_PLAIN_USERNAME=
# Secret: never commit; inject from a secret manager.
BROKER_SASL_PLAIN_PASSWORD=
BROKER_SSL_CAFILE=/etc/redpanda/certs/ca.crt
BROKER_SSL_CERTFILE=/etc/redpanda/certs/client.crt
BROKER_SSL_KEYFILE=/etc/redpanda/certs/client.key

# ---- Memory domain service (agent memory) -------------------------------------
# Broker-first memory_service (durable chat memory, compression summaries, user
# profiles/facts). Production runs every mode in 'broker' (never 'fake').
# See docs/agent-memory-design.md §3.8 and docs/agent-memory-requirements.md.
MEMORY_SERVICE_NAME=memory_service
MEMORY_IDENTITY_MODE=broker
MEMORY_INDEX_MODE=broker
MEMORY_SEARCH_MODE=broker
MEMORY_DB_PATH=/var/lib/rag/agent_memory.db
MEMORY_COLLECTION=agent_memory
MEMORY_DOCUMENTS_COLLECTION=agent_documents
MEMORY_ALLOWED_SERVICES=conversation-server

# Service-auth signing contract (single signing key). REQUIRED, no default.
# SERVICE_AUTH_SIGNING_KEY MUST equal simple_agent's SERVICE_AUTH_SIGNING_KEY —
# the RAG shared/service_auth.py is the mirror of simple_agent_service_auth and
# both sides sign/verify with this one shared key. Drift breaks every
# memory_service token verification.
SERVICE_AUTH_SIGNING_KEY=
# Issuer/audience/TTL must also match simple_agent's values (mirror the SA
# compose: simple-agent-local / simple-agent-internal / 300).
SERVICE_AUTH_TOKEN_ISSUER=simple-agent-local
SERVICE_AUTH_TOKEN_AUDIENCE=simple-agent-internal
SERVICE_AUTH_TOKEN_TTL_SECONDS=300
