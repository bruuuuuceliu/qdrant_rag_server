# Local task-service settings
TASK_SERVICE_NAME=task_service
TASK_SERVICE_TASK_REQUEST_TOPIC=task.requests
TASK_SERVICE_PROJECT_PLAN_REQUEST_TOPIC=project.plan.requests
TASK_SERVICE_PROJECT_PLAN_RESULT_TOPIC=project.plan.results
TASK_SERVICE_TASK_EVENT_TOPIC=task.events
TASK_SERVICE_TASK_RESULT_TOPIC=task.results
TASK_SERVICE_DEAD_LETTER_TOPIC=task.dead_letters
TASK_SERVICE_STATE_DB_PATH=.run/data/task_service_state.db
TASK_SERVICE_MAX_ATTEMPTS=3
TASK_SERVICE_HELPER_LEASE_SECONDS=300
TASK_SERVICE_RETRY_BACKOFF_SECONDS=0
TASK_SERVICE_RECOVERY_ENABLED=true
TASK_SERVICE_RECOVERY_POLL_SECONDS=2.0
TASK_SERVICE_RECOVERY_BATCH_SIZE=25
