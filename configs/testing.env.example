RAG_CONFIG_DB_PATH=/tmp/qdrant_retrieval_test/config.db
RAG_RESPONSE_CACHE_DB_PATH=/tmp/qdrant_retrieval_test/response_cache.db
RAG_GRPC_PORT=50051

RAG_MAX_PER_PROJECT=20
RAG_MAX_PER_USER=5
RAG_INGEST_WORKERS=2
RAG_INGEST_QUEUE_MAXSIZE=10
RAG_INGEST_JOB_DB_PATH=/tmp/qdrant_retrieval_test/ingestion_jobs.db
RAG_INGEST_EVENT_TOPIC=ingestion.events
RAG_INGEST_EVENT_QUEUE_MAXSIZE=100
WORKFLOW_LOG_SERVICE_ENABLED=true
WORKFLOW_LOG_SERVICE_NAME=workflow_log_service
WORKFLOW_LOG_TOPIC=ingestion.events
WORKFLOW_LOG_DB_PATH=/tmp/qdrant_retrieval_test/workflow_log.db
RAG_GENERATION_ENABLED=false
