RAG_CONFIG_DB_PATH=/var/lib/rag/config.db
RAG_RESPONSE_CACHE_DB_PATH=/var/lib/rag/response_cache.db
RAG_GRPC_PORT=50051

RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
# RAG_QDRANT_URL=http://localhost:6333

RAG_MAX_PER_PROJECT=20
RAG_MAX_PER_USER=5
RAG_INGEST_WORKERS=4

# Sparse retrieval. Project retrieval_config still controls whether a project
# uses dense, bm25, or hybrid search.
BM25_SPARSE_VECTOR_NAME=bm25
BM25_DENSE_VECTOR_NAME=dense
BM25_ENCODER_PROVIDER=fastembed
BM25_ENCODER_MODEL=Qdrant/bm25
BM25_TEXT_FIELD=text_lemmatized
BM25_LEMMATIZE=true
BM25_INDEX_VERSION=qdrant_bm25_v1

# NER is optional. Use disabled for dense/BM25 retrieval without enrichment.
RAG_NER_PROVIDER=disabled
RAG_NER_MODEL=en_core_web_sm

# Embeddings can run locally or through an OpenAI-compatible remote endpoint.
# local avoids provider keys; openrouter/remote avoids local model calculation.
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_DIMENSION=768
# RAG_EMBEDDING_API_KEY=sk-or-...
# RAG_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1/embeddings

# Generation is optional and uses request-scoped user/provider keys.
RAG_GENERATION_ENABLED=false
