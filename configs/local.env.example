RAG_CONFIG_PROFILE=local

# Local data/runtime defaults. By default, examples/local/run-all.sh stores
# mutable local data under .run/data and logs/PIDs under .run at the repository
# root.
# RAG_LOCAL_DATA_DIR=.run/data
# RAG_LOCAL_RUNTIME_DIR=.run

# Leave DB paths unset for run-all.sh local mode so it keeps all mutable data
# under .run/data. Set explicit absolute paths only for a deployment profile.
# RAG_CONFIG_DB_PATH=.run/data/config.db
# PROJECT_CONFIG_DB_PATH=.run/data/config.db
# RAG_RESPONSE_CACHE_DB_PATH=.run/data/response_cache.db
RAG_GRPC_PORT=50051
RAG_PROJECT_GRPC_PORT=50052
RETRIEVAL_HTTP_HOST=127.0.0.1
RETRIEVAL_HTTP_PORT=8081
RETRIEVAL_HTTP_READ_TIMEOUT=5.0
MANAGER_RETRIEVAL_CLIENT_MODE=local
MANAGER_RETRIEVAL_HTTP_BASE_URL=http://127.0.0.1:8081
MANAGER_RETRIEVAL_HTTP_TIMEOUT=30

RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
RAG_QDRANT_GRPC_PORT=6334
# RAG_QDRANT_URL=http://localhost:6333

# Broker-first local testing uses a Docker broker on 127.0.0.1:9092.
# Set BROKER_TYPE=kafka, or run examples/local/run-all.sh --broker kafka, to
# use Apache Kafka instead of the default Redpanda container.
# BROKER_TYPE=redpanda
# BROKER_BOOTSTRAP_SERVERS=127.0.0.1:9092

RAG_MAX_PER_PROJECT=20
RAG_MAX_PER_USER=5
RAG_MAX_CONCURRENT_SEARCHES=32
RAG_MAX_CONCURRENT_INGEST_SCHEDULES=32
RAG_INGEST_WORKERS=1
RAG_INGEST_QUEUE_MAXSIZE=100
# RAG_INGEST_JOB_DB_PATH=.run/data/ingestion_jobs.db
# INGESTION_JOB_DB_PATH=.run/data/ingestion_jobs.db
RAG_INGEST_EVENT_TOPIC=ingestion.events
RAG_INGEST_EVENT_QUEUE_MAXSIZE=1000
WORKFLOW_LOG_SERVICE_ENABLED=true
WORKFLOW_LOG_SERVICE_NAME=workflow_log_service
WORKFLOW_LOG_TOPIC=ingestion.events
WORKFLOW_LOG_DB_PATH=.run/data/workflow_log.db

MANAGER_INGEST_TOPIC=ingestion.requests
MANAGER_WORKFLOW_TOPIC=workflow.events
MANAGER_LOCAL_QUEUE_MAXSIZE=1000
# MANAGER_INGESTION_WORKER_MODE=embedded
# MANAGER_QUEUE_BROKER=local
# MANAGER_QUEUE_DB_PATH=.run/data/ingestion_queue.db
# MANAGER_PROJECT_CLIENT_MODE=local
# MANAGER_PROJECT_GRPC_TARGET=localhost:50052

# Standalone ingestion worker settings used by --external-ingestion or
# --split-services.
# INGESTION_QUEUE_BROKER=sqlite
# INGESTION_QUEUE_DB_PATH=.run/data/ingestion_queue.db
# INGESTION_RETRIEVAL_INDEX_ENABLED=true
# INGESTION_RETRIEVAL_INDEX_TOPIC=retrieval.index.requests
# INGESTION_RETRIEVAL_INDEX_QUEUE_BROKER=sqlite
# INGESTION_RETRIEVAL_INDEX_QUEUE_DB_PATH=.run/data/ingestion_queue.db
# INGESTION_RETRIEVAL_INDEX_QUEUE_MAXSIZE=100
# INGESTION_RETRIEVAL_INDEX_RESPONSE_TIMEOUT=30

# Standalone retrieval index worker settings used by --split-services.
# RETRIEVAL_INDEX_WORKER_ENABLED=true
# RETRIEVAL_INDEX_REQUEST_TOPIC=retrieval.index.requests
# RETRIEVAL_INDEX_QUEUE_BROKER=sqlite
# RETRIEVAL_INDEX_QUEUE_DB_PATH=.run/data/ingestion_queue.db
# RETRIEVAL_INDEX_QUEUE_MAXSIZE=100

# Retrieval/database placement. Local mode registers the configured Qdrant as a
# single placement shard, while preserving placement_plan messages for future
# multi-shard routing.
RETRIEVAL_PLACEMENT_ENABLED=true
RETRIEVAL_PLACEMENT_DB_PATH=.run/data/placement.db
RETRIEVAL_PLACEMENT_ROUTING_MODE=project_single
RETRIEVAL_PLACEMENT_BUCKET_COUNT=1
RETRIEVAL_PLACEMENT_REPLICATION_FACTOR=1
RETRIEVAL_PLACEMENT_SHARD_ID=local-qdrant
RETRIEVAL_PLACEMENT_CLUSTER_ID=local

# Sparse retrieval. Project retrieval_config still controls whether a project
# uses dense, bm25, or hybrid search.
BM25_SPARSE_VECTOR_NAME=bm25
BM25_DENSE_VECTOR_NAME=dense
BM25_ENCODER_PROVIDER=fastembed
BM25_ENCODER_MODEL=Qdrant/bm25
BM25_TEXT_FIELD=text_lemmatized
BM25_LEMMATIZE=true
BM25_INDEX_VERSION=qdrant_bm25_v1

# NER is optional. Use disabled for dense/BM25 retrieval without enrichment.
RAG_NER_PROVIDER=disabled
RAG_NER_MODEL=en_core_web_sm

# Embeddings can run locally or through an OpenAI-compatible remote endpoint.
# local avoids provider keys; openrouter/remote avoids local model calculation.
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_DIMENSION=768
# RAG_EMBEDDING_API_KEY=sk-or-...
# RAG_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1/embeddings

# Generation is optional and uses request-scoped user/provider keys.
RAG_GENERATION_ENABLED=false

RAG_QDRANT_CONTAINER=qdrant-rag-local
RAG_QDRANT_VOLUME=qdrant-rag-local-data
