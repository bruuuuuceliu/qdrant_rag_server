MANAGER_SERVICE_NAME=manager_service
MANAGER_INGEST_TOPIC=ingestion.requests
MANAGER_WORKFLOW_TOPIC=workflow.events
MANAGER_INGESTION_WORKER_MODE=embedded
MANAGER_QUEUE_BROKER=local
# MANAGER_QUEUE_DB_PATH=/tmp/qdrant_rag/ingestion_queue.db
MANAGER_LOCAL_QUEUE_MAXSIZE=1000
MANAGER_RETRIEVAL_CLIENT_MODE=local
MANAGER_RETRIEVAL_TOPIC=retrieval.api.requests
MANAGER_RETRIEVAL_RESPONSE_TIMEOUT=30
MANAGER_RETRIEVAL_HTTP_BASE_URL=http://127.0.0.1:8081
MANAGER_RETRIEVAL_HTTP_TIMEOUT=30
MANAGER_TASK_INTAKE_TOPIC=task.intake
REDIS_TASK_STATUS_URL=redis://127.0.0.1:6379/0
REDIS_TASK_STATUS_KEY_PREFIX=task:
REDIS_TASK_COMPLETED_TTL_SECONDS=86400
