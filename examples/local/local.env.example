# Copy to examples/local/local.env and edit as needed.

# Local data/runtime defaults. By default, run-all.sh stores mutable local data
# under examples/local/.data and logs/PIDs under .run at the repository root.
# RAG_LOCAL_DATA_DIR=examples/local/.data
# RAG_LOCAL_RUNTIME_DIR=.run

RAG_GRPC_PORT=50051
RAG_PROJECT_GRPC_PORT=50052
RAG_QDRANT_HOST=localhost
RAG_QDRANT_PORT=6333
RAG_QDRANT_GRPC_PORT=6334

RAG_MAX_PER_PROJECT=20
RAG_MAX_PER_USER=5
RAG_MAX_CONCURRENT_SEARCHES=32
RAG_MAX_CONCURRENT_INGEST_SCHEDULES=32
RAG_INGEST_WORKERS=1
RAG_INGEST_QUEUE_MAXSIZE=100
RAG_INGEST_EVENT_TOPIC=ingestion.events
RAG_INGEST_EVENT_QUEUE_MAXSIZE=1000

MANAGER_INGEST_TOPIC=ingestion.requests
MANAGER_WORKFLOW_TOPIC=workflow.events
MANAGER_LOCAL_QUEUE_MAXSIZE=1000
# MANAGER_INGESTION_WORKER_MODE=embedded
# MANAGER_QUEUE_BROKER=local
# MANAGER_QUEUE_DB_PATH=examples/local/.data/ingestion_queue.db
# MANAGER_PROJECT_CLIENT_MODE=local
# MANAGER_PROJECT_GRPC_TARGET=localhost:50052

# Standalone ingestion worker settings used by --external-ingestion or
# --split-services.
# INGESTION_QUEUE_BROKER=sqlite
# INGESTION_QUEUE_DB_PATH=examples/local/.data/ingestion_queue.db
# INGESTION_PROJECT_CLIENT_MODE=local
# INGESTION_PROJECT_GRPC_TARGET=localhost:50052

WORKFLOW_LOG_SERVICE_ENABLED=true
WORKFLOW_LOG_TOPIC=ingestion.events

# local loads a sentence-transformers model; openrouter/remote requires an API key.
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_DIMENSION=768
# RAG_EMBEDDING_API_KEY=sk-or-...
# RAG_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1/embeddings

RAG_GENERATION_ENABLED=false
# RAG_GENERATION_API_KEY=sk-or-...

RAG_QDRANT_CONTAINER=qdrant-rag-local
RAG_QDRANT_VOLUME=qdrant-rag-local-data
